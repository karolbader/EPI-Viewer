{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EPI Viewer",
  "version": "0.1.0",
  "identifier": "com.civitas.epi.viewer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "EPI Viewer",
        "width": 1360,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
